<?xml version="1.0"?>
<database xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/database.xsd">
    <table>
        <name>*dbprefix*bookshelfs</name>
        <declaration>
            <field>
                <name>id</name>
                <type>bigint</type>
                <length>4</length>
                <notnull>true</notnull>
                <autoincrement>true</autoincrement>
            </field>
            <field>
                <name>user_id</name>
                <type>string</type>
                <length>64</length>
                <notnull>true</notnull>
            </field>
            <field>
                <name>title</name>
                <type>string</type>
                <length>36</length>
                <notnull>true</notnull>
            </field>
            <field>
                <name>author</name>
                <type>string</type>
                <length>4</length>
                <notnull>true</notnull>
            </field>
            <field>
                <name>position</name>
                <type>bigint</type>
                <length>4</length>
                <notnull>true</notnull>
            </field>
            <field>
                <name>url</name>
                <type>text</type>
                <notnull>true</notnull>
            </field>
            <field>
                <name>file</name>
                <type>bigint</type>
                <length>4</length>
                <notnull>true</notnull>
            </field>
            <field>
                <name>colour</name>
                <type>string</type>
                <length>64</length>
                <notnull>true</notnull>
            </field>
            <field>
                <name>pattern</name>
                <type>smallint</type>
                <notnull>true</notnull>
            </field>
            <field>
                <name>height</name>
                <type>smallint</type>
                <notnull>true</notnull>
            </field>
            <index>
                <name>bookshelfs_id_user_index</name>
                <primary>true</primary>
                <unique>true</unique>
                <field>
                    <name>id</name>
                </field>
                <field>
                    <name>user</name>
                </field>
            </index>
            <index>
                <name>bookshelfs_user_index</name>
                <field>
                    <name>user</name>
                </field>
            </index>
        </declaration>
    </table>
</database>
